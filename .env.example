# ============================================================================
# SFSA Agentic RAG - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Make sure .env is in your .gitignore to keep secrets safe!

# ─── LangSmith Configuration (for tracing and debugging) ────────────────────
# LangSmith is a third-party cloud service: with tracing on, every prompt and the
# retrieved wiki text is sent to it. SFSA's deployment keeps this OFF.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=SFSA-Agentic-RAG

# ─── Web search (Tavily) -- DISABLED for SFSA ───────────────────────────────
# Project decision (Dave/SFSA, 2026-09-17; reaffirmed by Revanth, 2026-09-28): off.
# The tavily-python package itself isn't installed (see environment.yml), so this
# is off by more than a setting. Even if the switch below were mistakenly set to
# true, nothing would be sent -- the code checks the switch first, and falls back
# to "no results" if the package is missing either way.
# When on, the reformulated question is sent to Tavily's servers. Re-enabling needs
# ALL three: uncomment tavily-python in environment.yml, the switch below, and a
# real key -- plus a decision-log entry.
SFSA_WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=

# ─── Ollama Configuration ───────────────────────────────────────────────────
# Base URL for Ollama server (default: http://localhost:11434)
SFSA_OLLAMA_BASE_URL=http://localhost:11434

# Model name to use (must be pulled in Ollama first)
# Run: ollama pull llama3.1:8b
SFSA_OLLAMA_MODEL=llama3.1:8b

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
SFSA_OLLAMA_TEMPERATURE=0.3
SFSA_OLLAMA_MAX_TOKENS=1000

# ─── Vector Database Configuration ──────────────────────────────────────────
# Path to the FAISS vector database (relative to project root)
SFSA_VECTORDB_PATH=src/sfsa_rag_assistant/data/vectordb

# Embedding model for retrieval
SFSA_EMBEDDING_MODEL=Alibaba-NLP/gte-large-en-v1.5

# Number of documents to retrieve
SFSA_RETRIEVAL_K=5

# ─── Agent Configuration ─────────────────────────────────────────────────────
# Maximum validation attempts (Agent 3 loop limit)
SFSA_MAX_VALIDATION_ATTEMPTS=2

# Tavily max search results
SFSA_TAVILY_MAX_RESULTS=3

# ─── Output Configuration ────────────────────────────────────────────────────
# Directory for saving results
SFSA_OUTPUT_DIR=data/outputs

# ─── Optional: HuggingFace (for fallback or testing) ────────────────────────
# HUGGINGFACE_API_TOKEN=your_hf_token_here

# ─── Chat API: wiki-login authentication (production) ───────────────────────
# The API has no accounts or passwords of its own. It asks the wiki who a request's
# login cookie belongs to, and denies everything it cannot confirm.
# Defaults are the production values; override only for a test wiki.
# The wiki's API endpoint (must be https):
# SFSA_WIKI_API_URL=https://wiki.sfsa.org/api.php
# The wiki's cookie prefix ($wgCookiePrefix, else the database name):
# SFSA_WIKI_COOKIE_PREFIX=wiki_db
# Only if the wiki is reached under a different name than its TLS certificate
# (e.g. a test copy). Verification stays ON; it is checked against this name:
# SFSA_WIKI_TLS_SERVER_NAME=wiki.sfsa.org
# Origins allowed to send chat requests (comma-separated) -- this server itself:
# SFSA_ALLOWED_ORIGINS=https://rag.sfsa.org
# Wiki origins allowed to embed the chat iframe (comma-separated):
# SFSA_FRAME_ANCESTORS=https://wiki.sfsa.org
# Hosts the chat will show as clickable citation links (comma-separated):
# SFSA_CITATION_HOSTS=wiki.sfsa.org
# Simultaneous questions across all members (each member gets one at a time):
# SFSA_MAX_INFLIGHT=8
